version: 1.0

// H6 regression: param-dependent repeat count forces codegen into the runtime-
// rebuild branch (ProgrammableCodeGen.rebuildRepeatChildren ->
// generateRuntimeChildExprs). INTERACTIVE is not handled inline — it falls into
// the `default:` arm at ProgrammableCodeGen.hx:2961-2968, which forwards to
// ProgrammableBuilder.buildNodeByUniqueName(...). That fallback skips
// recordUntrackedParams, so setParameter("myId", ...) silently updates the
// internal field with no throw and no visual effect.
//
// The static-count baseline lives in codegenIncUntrackedId
// (111-codegenIncrementalInteractiveStateanim.manim) and correctly throws
// "untracked_param". This fixture pins the same behavior inside a param-dep
// repeat body.
//
// `n` drives the repeat count. `myId` is the param that should be flagged as
// untracked because it flows through the interactive id.
#paramDepRepeatUntrackedId programmable(n:uint=2, myId:string="btn") {
  repeatable($i, step($n, dx: 60)) {
    interactive(100, 50, $myId): 0, 0
  }
}

// Leaf programmables referenced by the dynamicRef/staticRef regression tests below.
#leafA programmable() {
  bitmap(generated(color(10, 10, #FF0000))): 0, 0
}
#leafB programmable() {
  bitmap(generated(color(10, 10, #00FF00))): 0, 0
}

// Param `template` flows into a dynamicRef target inside a param-dep repeat body.
// The fallback build path (incrementalMode=false) does not call trackDynamicName,
// so changing it must throw untracked_param, not silently no-op.
#paramDepRepeatUntrackedDynRefTarget programmable(n:uint=2, template:string="leafA") {
  repeatable($i, step($n, dx: 60)) {
    dynamicRef($template): 0, 0
  }
}

// Param `mode` flows into conditional visibility on children inside a param-dep
// repeat body. Conditional refs are not collected by the current helpers; the body
// is only rebuilt on count change, so setParameter("mode", ...) must throw.
#paramDepRepeatUntrackedCondition programmable(n:uint=2, mode:[a,b]=a) {
  repeatable($i, step($n, dx: 60)) {
    @($mode=>a) bitmap(generated(color(10, 10, #FF0000))): 0, 0
    @else bitmap(generated(color(10, 10, #00FF00))): 0, 0
  }
}

// Param `offX` flows into a child position inside a param-dep repeat body. The
// fallback path does not register a tracked position expression, so updating it
// must throw rather than leaving stale coordinates.
#paramDepRepeatUntrackedChildPos programmable(n:uint=2, offX:int=5) {
  repeatable($i, step($n, dx: 60)) {
    bitmap(generated(color(10, 10, #FF0000))): $offX, 0
  }
}
