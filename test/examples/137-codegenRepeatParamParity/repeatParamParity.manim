version: 1.0

// Codegen/builder parity for param-dependent repeat iterators and flow embedding.
//
// - step() offsets referencing programmable params: the builder resolves them at
//   build time; codegen's static resolve must not silently fall back to 0.
// - range() with param-dependent start/step: loop values must be start + i*step
//   (codegen currently gets the count right but bakes start=0, step=1).
// - repeatable directly inside a flow with no step offsets: the builder adds the
//   iteration children directly to the flow so it lays them out individually;
//   codegen must not hide them all inside one wrapper container.

// Static count, param-dependent dx (static-resolve path).
#stepParamOffsets programmable(dx:int=20) {
  repeatable($i, step(3, dx: $dx)) {
    bitmap(generated(color(4, 4, #FF0000))): 0, 0
  }
}

// Param-dependent count AND param-dependent dx (runtime rebuild path).
#stepParamOffsetsRt programmable(n:int=3, dx:int=20) {
  repeatable($i, step($n, dx: $dx)) {
    bitmap(generated(color(4, 4, #00FF00))): 0, 0
  }
}

// Param-dependent range start/step; the bitmap x mirrors the loop value.
#rangeParamBounds programmable(start:int=5, stepv:int=2) {
  repeatable($i, range($start, 11, $stepv)) {
    bitmap(generated(color(4, 4, #0000FF))): $i, 0
  }
}

// Zero-offset repeatable inside a flow: flow must see each iteration child.
#flowRepeat programmable() {
  flow(layout: horizontal) {
    repeatable($i, step(3, dx: 0)) {
      bitmap(generated(color(10, 10, #FFFF00))): 0, 0
    }
  }
}

// Descending `to:` is inclusive (5,4,3,2,1) — literal step: static unroll path.
#rangeDescendingTo programmable() {
  repeatable($i, range(from: 5, to: 1, step: -1)) {
    bitmap(generated(color(4, 4, #FF00FF))): $i, 0
  }
}

// Descending `to:` with a $param step (runtime rebuild path): the step's sign is only
// known at build time.
#rangeDescendingToParamStep programmable(stepv:int=-2) {
  repeatable($i, range(from: 10, to: 2, step: $stepv)) {
    bitmap(generated(color(4, 4, #00FFFF))): $i, 0
  }
}

// A $param step of 0 must fail like the builder does (JS used to loop forever).
#rangeZeroParamStep programmable(stepv:int=0) {
  repeatable($i, range(0, 5, $stepv)) {
    bitmap(generated(color(4, 4, #FFFFFF))): $i, 0
  }
}

// A point inside a param-dependent repeat (runtime rebuild path) holding a child that
// codegen forwards to the builder at runtime: the child must be added to the point.
#pointForwardedChild programmable(n:int=2) {
  repeatable($i, step($n, dx: 20)) {
    point {
      pos: 0, 0
      interactive(10, 10, $i): 0, 0
    }
  }
}
