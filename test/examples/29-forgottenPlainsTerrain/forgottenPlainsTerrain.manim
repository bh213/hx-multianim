version: 1.0

// =============================================================================
// FORGOTTEN PLAINS TERRAIN - Real tileset autotile
// =============================================================================
// Uses Minifantasy_ForgottenPlainsTiles.png with region and mapping (cross format)
//
// Tileset: Minifantasy - Forgotten Plains by Krishna Palacio
// https://krishna-palacio.itch.io/minifantasy-forgotten-plains
// =============================================================================

// Dirt patch on grass from the Minifantasy tileset: "terrain present" = dirt.
// Tileset is 69 columns x 23 rows of 8x8 tiles (552x184 pixels).
// Region [56, 24, 24, 40] = tileset columns 7-9, rows 3-7 (3x5 = 15 tiles, region index in brackets):
//   Row 3: [0] 214 NW outer   [1] 215 N edge      [2] 216 NE outer
//   Row 4: [3] 283 W edge     [4] 284 center      [5] 285 E edge
//   Row 5: [6] 352 SW outer   [7] 353 S edge      [8] 354 SE outer
//   Row 6: [9] 421 inner NW   [10] 422 inner NE   [11] 423 diagonal (grass notches NW + SE)
//   Row 7: [12] 490 inner SW  [13] 491 inner SE   [14] 492 diagonal (grass notches NE + SW)
// "inner XX" = grass notch in the XX corner (all four sides dirt, XX diagonal grass).
// The cross format has no diagonal tiles, so [11] and [14] are unused here (format: corner uses them).
// Cross format: 0=N, 1=W, 2=C, 3=E, 4=S, 5-8=outer corners, 9-12=inner corners
#dirtTerrain autotile {
    format: cross
    tileSize: 8
    file: "Tileset/Minifantasy_ForgottenPlainsTiles.png"
    region: [56, 24, 24, 40]
    mapping: [
        1,    // 0: N edge      -> [1] 215
        3,    // 1: W edge      -> [3] 283
        4,    // 2: Center      -> [4] 284
        5,    // 3: E edge      -> [5] 285
        7,    // 4: S edge      -> [7] 353
        0,    // 5: NW outer    -> [0] 214
        2,    // 6: NE outer    -> [2] 216
        6,    // 7: SW outer    -> [6] 352
        8,    // 8: SE outer    -> [8] 354
        10,   // 9: inner NE    -> [10] 422
        9,    // 10: inner NW   -> [9] 421
        13,   // 11: inner SE   -> [13] 491
        12    // 12: inner SW   -> [12] 490
    ]
}

// Demo autotile for comparison - shows expected tile positions
#dirtDemo autotile {
    format: cross
    tileSize: 8
    demo: #66AA44, #886644    // green edges, brown fill (matches tileset)
}

// Visual demo element - shows all 13 tiles with labels
#forgottenPlainsTerrain programmable() {
    pos: 0, 0
    grid: 1280, 720

    @alpha(0.1) bitmap(generated(color(1280, 720, black)));

    // Title
    text(f3x5, "FORGOTTEN PLAINS - Cross Format Tiles", white, left):10,10

    // === EDGES (0-4) ===
    text(f3x5, "Edges:", #FF6666, left):10,30
    // 0: N edge
    point {
        pos: 50, 28
        text(f3x5, "0", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 0))):0,0
        bitmap(generated(autotile("dirtTerrain", 0))):10,0
    }
    // 1: W edge
    point {
        pos: 80, 28
        text(f3x5, "1", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 1))):0,0
        bitmap(generated(autotile("dirtTerrain", 1))):10,0
    }
    // 2: Center
    point {
        pos: 110, 28
        text(f3x5, "2", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 2))):0,0
        bitmap(generated(autotile("dirtTerrain", 2))):10,0
    }
    // 3: E edge
    point {
        pos: 140, 28
        text(f3x5, "3", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 3))):0,0
        bitmap(generated(autotile("dirtTerrain", 3))):10,0
    }
    // 4: S edge
    point {
        pos: 170, 28
        text(f3x5, "4", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 4))):0,0
        bitmap(generated(autotile("dirtTerrain", 4))):10,0
    }

    // === OUTER CORNERS (5-8) ===
    text(f3x5, "Outer:", #FFCC00, left):10,48
    // 5: NW outer
    point {
        pos: 50, 46
        text(f3x5, "5", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 5))):0,0
        bitmap(generated(autotile("dirtTerrain", 5))):10,0
    }
    // 6: NE outer
    point {
        pos: 80, 46
        text(f3x5, "6", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 6))):0,0
        bitmap(generated(autotile("dirtTerrain", 6))):10,0
    }
    // 7: SW outer
    point {
        pos: 110, 46
        text(f3x5, "7", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 7))):0,0
        bitmap(generated(autotile("dirtTerrain", 7))):10,0
    }
    // 8: SE outer
    point {
        pos: 140, 46
        text(f3x5, "8", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 8))):0,0
        bitmap(generated(autotile("dirtTerrain", 8))):10,0
    }

    // === INNER CORNERS (9-12) ===
    text(f3x5, "Inner:", #4488FF, left):10,66
    // 9: iNE inner
    point {
        pos: 50, 64
        text(f3x5, "9", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 9))):0,0
        bitmap(generated(autotile("dirtTerrain", 9))):10,0
    }
    // 10: iNW inner
    point {
        pos: 80, 64
        text(f3x5, "10", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 10))):0,0
        bitmap(generated(autotile("dirtTerrain", 10))):10,0
    }
    // 11: iSE inner
    point {
        pos: 110, 64
        text(f3x5, "11", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 11))):0,0
        bitmap(generated(autotile("dirtTerrain", 11))):10,0
    }
    // 12: iSW inner
    point {
        pos: 140, 64
        text(f3x5, "12", white, right):-2,0
        bitmap(generated(autotile("dirtDemo", 12))):0,0
        bitmap(generated(autotile("dirtTerrain", 12))):10,0
    }

    // Legend
    text(f3x5, "Left=demo, Right=tileset tile", #888888, left):10,82
}
