version: 1.0

// =============================================================================
// BLOB47 FALLBACK TEST - Tests blob47 with partial tileset (uses fallback)
// =============================================================================
// Uses Forgotten Plains tileset with blob47 format.
// 35 of 47 indices are mapped - the rest use automatic fallback.
// =============================================================================

// Demo autotile for comparison
#blob47Demo autotile {
    format: blob47
    tileSize: 8
    demo: #66AA44, #886644    // green edges (grass border), brown fill (dirt center)
}

// Blob47 autotile using the Forgotten Plains dirt collection (dirt = terrain, grass around it).
// Region [8, 8, 80, 96] = tileset columns 1-10, rows 1-12 (index = row * 10 + column). Besides the
// 3x5 patch (26-28, 36-38, 46-48 = outer corners/edges/center, 56-58 + 66-68 = inner corners and
// diagonals) it holds an isolated blob (4), strip caps (95/115, 86/88), 1-wide strips (105, 87),
// 1-wide corners / T-junctions / cross (96-98, 106-108, 116-118) and junction notches (92, 101,
// 103, 112). 35 of the 47 blob47 indices have an exact tile; the other 12 (an edge plus an inner
// notch, or three notches) exercise the allowPartialMapping fallback.
#blob47Dirt autotile {
    format: blob47
    tileSize: 8
    file: "Tileset/Minifantasy_ForgottenPlainsTiles.png"
    region: [8, 8, 80, 96]
    allowPartialMapping: true
    // blob47 index (which neighbours are dirt) -> region tile
    mapping: [
        0:4,     // isolated               -> single blob
        1:115,   // N only                 -> vertical strip, bottom cap
        2:86,    // E only                 -> horizontal strip, left cap
        3:116,   // N+E                    -> 1-wide corner
        4:46,    // N+NE+E                 -> patch SW outer
        5:95,    // S only                 -> vertical strip, top cap
        6:105,   // N+S                    -> vertical strip
        7:96,    // E+S                    -> 1-wide corner
        8:106,   // N+E+S                  -> 1-wide T
        10:26,   // E+SE+S                 -> patch NW outer
        12:36,   // N+NE+E+SE+S            -> patch W edge
        13:88,   // W only                 -> horizontal strip, right cap
        14:118,  // N+W                    -> 1-wide corner
        15:87,   // E+W                    -> horizontal strip
        16:117,  // N+E+W                  -> 1-wide T
        18:98,   // S+W                    -> 1-wide corner
        19:108,  // N+S+W                  -> 1-wide T
        20:97,   // E+S+W                  -> 1-wide T
        21:107,  // N+E+S+W, no diagonals  -> 1-wide cross
        25:101,  // all but NW, SW         -> junction, notches W
        26:28,   // S+SW+W                 -> patch NE outer
        30:58,   // all but NW, SE         -> diagonal notches
        31:27,   // E+SE+S+SW+W            -> patch N edge
        32:92,   // all but NE, NW         -> junction, notches N
        33:56,   // all but NW             -> inner NW
        34:48,   // N+W+NW                 -> patch SE outer
        36:47,   // N+NE+E+W+NW            -> patch S edge
        39:112,  // all but SE, SW         -> junction, notches S
        40:68,   // all but NE, SW         -> diagonal notches
        41:66,   // all but SW             -> inner SW
        42:38,   // N+S+SW+W+NW            -> patch E edge
        43:103,  // all but NE, SE         -> junction, notches E
        44:67,   // all but SE             -> inner SE
        45:57,   // all but NE             -> inner NE
        46:37    // all neighbours         -> patch center
    ]
}

// Visual demo - shows all 47 tiles with demo + tileset comparison, then map
#blob47Fallback programmable() {
    pos: 0, 0
    grid: 1280, 720

    @alpha(0.1) bitmap(generated(color(1280, 720, black)));

    // Show all 47 tiles: demo shape (top) vs tileset with fallback (bottom)
    // 8x8 tiles scaled 2x = 16x16 display, 20 tiles per row, 36px spacing (16+2+16+2)
    text(f3x5, "Top: demo shape, Bottom: tileset (unmapped indices use fallback)", #888888, left):10,10

    // Row labels
    text(f3x5, "0-19:", #666666, right):28,24
    text(f3x5, "20-39:", #666666, right):28,62
    text(f3x5, "40-46:", #666666, right):28,100

    // Display all 47 tiles in rows of 20, scaled 2x
    repeatable($i, range(0, 47)) {
        point {
            pos: 35 + ($i % 20) * 20, 22 + ($i div 20) * 38
            // Demo tile (top) - shows expected shape, scaled 2x
            @scale(2) bitmap(generated(autotile("blob47Demo", $i))):0,0
            // Tileset tile (bottom) - unmapped indices use fallback, scaled 2x
            @scale(2) bitmap(generated(autotile("blob47Dirt", $i))):0,18
        }
    }

    // Map section
    text(f3x5, "Terrain Map - Demo (left) vs Tileset with fallback (right)", #888888, left):10,142

    // Map backgrounds positioned for test code
    bitmap(generated(color(136, 104, black))):10,152
    bitmap(generated(color(136, 104, black))):160,152

    // Region sheet visualization - shows the tileset region with numbered grid
    // autotileRegionSheet(autotileName, scale, font, fontColor) - scale tiles but not font
    text(f3x5, "Region Sheet (blob47Dirt):", #888888, left):320,142
    bitmap(generated(autotileRegionSheet("blob47Dirt", 2, "f3x5", white))):320,152
}
